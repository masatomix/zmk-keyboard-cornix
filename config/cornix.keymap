/*
 * Cornix LP Custom Keymap
 * Based on default keymap structure, layers converted from Vial MigratedLayout.vil
 * Source: masatomix/task docs/research/543_keyball-cornix-migration/
 *
 * SPDX-License-Identifier: MIT
 */

#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define HM_TAPPING_TERM 250
#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base QWERTY
        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB        &kp Q     &kp W     &kp E   &kp R        &kp T                                  &kp Y        &kp U       &kp I      &kp O      &kp P          &kp EQUAL
&mt LCTRL ESC  &kp A     &kp S     &kp D   &lt 3 F      &kp G                                  &kp H        &kp J       &kp K      &kp L      &mt RGUI SEMI  &mt RCTRL SQT
&kp LSHFT      &kp Z     &kp X     &kp C   &kp V        &kp B       &kp C_MUTE   &mkp MB3      &kp N        &kp M       &kp COMMA  &lt 3 DOT  &kp FSLH       &mt RSHFT BSLH
&kp LCTRL      &kp LALT  &kp LGUI  &mo 6   &lt 1 SPACE  &lt 2 LANG2                            &lt 1 BSPC   &lt 4 RET   &none      &mo 5      &lt 6 GRAVE    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 1: Navigation
        nav_layer {
            display-name = "Nav";
            bindings = <
&kp F11         &kp LC(UP)    &kp LC(DOWN)  &kp PG_UP  &kp UP     &trans                              &trans    &trans    &trans     &kp PG_UP  &kp UP    &trans
&kp LS(LCTRL)   &kp C_VOL_DN  &kp C_VOL_UP  &kp DEL    &kp RIGHT  &kp LA(ESC)                         &kp BSPC  &kp DOWN  &kp UP     &kp RIGHT  &trans    &trans
&trans          &mkp MB4      &mkp MB5      &kp PG_DN  &kp DOWN   &kp LEFT     &kp C_MUTE  &mkp MB3   &kp DOWN  &kp LEFT  &trans     &kp PG_DN  &trans    &trans
&trans          &trans        &trans        &trans     &trans     &trans                              &kp DEL   &trans    &trans     &trans     &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 2: F-keys
        fkeys_layer {
            display-name = "F-keys";
            bindings = <
&trans  &trans  &trans  &mt LGUI E  &trans  &trans                          &trans  &trans  &trans  &trans  &trans   &trans
&trans  &kp F1  &kp F2  &kp F3      &kp F4  &kp F5                          &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans      &trans  &trans  &kp C_MUTE  &mkp MB3    &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans      &trans  &trans                          &trans  &trans  &trans  &trans  &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 3: Mouse
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans    &trans    &trans  &trans    &trans                          &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans    &trans    &trans  &trans    &trans                          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &mkp MB4  &mkp MB5  &trans  &trans    &trans  &kp C_MUTE  &mkp MB3  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans    &trans    &trans  &mkp MB1  &trans                          &trans  &trans    &trans    &trans    &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 4: Alt-modifier (LT4 = Enter hold)
        altmod_layer {
            display-name = "AltMod";
            bindings = <
&trans  &trans  &trans     &trans     &trans     &kp LA(T)                          &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans                             &kp LA(H)  &kp LA(J)  &kp LA(K)  &kp LA(L)  &trans  &trans
&trans  &trans  &kp LA(X)  &kp LA(C)  &kp LA(V)  &trans     &kp C_MUTE  &mkp MB3  &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans                             &trans     &trans     &trans     &trans     &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 5: BT Management (MO(5) from Layer 0 right thumb)
        bt_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR_ALL  &none         &none  &none  &none  &none                       &none  &none  &none  &none  &none  &none
&bt BT_SEL 0    &bt BT_CLR    &none  &none  &none  &none                       &none  &none  &none  &none  &none  &none
&bt BT_SEL 1    &none         &none  &none  &none  &none  &kp C_MUTE  &none    &none  &none  &none  &none  &none  &none
&bt BT_SEL 2    &none         &none  &none  &none  &none                       &none  &none  &none  &none  &none  &none
            >;
        };

        // Layer 6: Symbols / Numbers
        symnum_layer {
            display-name = "SymNum";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                          &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp UNDER
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                             &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp LANG1  &mkp MB4  &mkp MB5  &trans    &kp LBRC  &kp LBKT    &kp C_MUTE  &mkp MB3  &kp RBKT   &kp RBRC  &trans     &trans    &trans    &trans
&trans     &trans    &trans    &trans    &trans    &trans                             &trans     &trans    &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
